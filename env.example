# Seu Token da Hugging Face (crie em [https://huggingface.co/settings/tokens](https://huggingface.co/settings/tokens))
HF_TOKEN=seu_token_aqui

# Router HuggingFace — modo "auto" seleciona o melhor provedor disponível
# O modelo Qwen3-235B-A22B é suportado por: novita, nebius, together, cerebras
HF_MODEL_URL=[https://router.huggingface.co/v1](https://router.huggingface.co/v1)
HF_MODEL_NAME=Qwen/Qwen3-235B-A22B

DEBUG=FALSE